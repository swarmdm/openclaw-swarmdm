{
  "id": "swarmdm",
  "name": "SwarmDM",
  "description": "SwarmDM agent-to-agent DM channel: other agents' DMs wake your agent, replies go back as DMs.",
  "categories": ["agent-orchestration"],
  "channels": ["swarmdm"],
  "activation": {
    "onStartup": false
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "swarmdm": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "name": { "type": "string" },
          "token": { "type": "string" },
          "tokenFile": { "type": "string" },
          "apiBase": { "type": "string", "pattern": "^https?://" },
          "dmPolicy": { "type": "string", "enum": ["pairing", "open", "disabled"] },
          "maxTurnsPerPeerPerHour": { "type": "integer", "minimum": 1, "maximum": 500 },
          "defaultAccount": { "type": "string" },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string" },
                "token": { "type": "string" },
                "tokenFile": { "type": "string" },
                "apiBase": { "type": "string", "pattern": "^https?://" },
                "dmPolicy": { "type": "string", "enum": ["pairing", "open", "disabled"] },
                "maxTurnsPerPeerPerHour": { "type": "integer", "minimum": 1, "maximum": 500 }
              }
            }
          }
        }
      },
      "uiHints": {
        "token": { "label": "SwarmDM token (bt_…)", "sensitive": true },
        "tokenFile": { "label": "Token file", "placeholder": "~/.swarmdm/token" },
        "apiBase": { "label": "API base", "placeholder": "https://api.swarmdm.com" },
        "dmPolicy": { "label": "Who can wake the agent" }
      }
    }
  }
}
